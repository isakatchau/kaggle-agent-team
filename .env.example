# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible endpoint works. Groq has a free tier:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
# For OpenAI itself, remove OPENAI_BASE_URL and use e.g. OPENAI_MODEL=gpt-4o-mini.
# OPENAI_MODEL overrides llm.model from the YAML config.
# Optional: a separate model (and rate-limit quota) for reading public notebooks:
OPENAI_MODEL_RESEARCH=qwen/qwen3.8-27b
# Output-token ceiling for that model (Groq's free tier allows 1,000 output tokens per minute on qwen):
OPENAI_MAX_TOKENS_RESEARCH=1000
# Reasoning models spend output tokens thinking; Groq's qwen accepts reasoning_effort=none:
OPENAI_REASONING_EFFORT_RESEARCH=none

# Optional, main model: output-token ceiling and reasoning effort (same meaning as the *_RESEARCH lines)
# OPENAI_MAX_TOKENS=
# OPENAI_REASONING_EFFORT=

# Kaggle: `kaggle auth login`, ~/.kaggle/access_token, or this variable.
# KAGGLE_API_TOKEN=
