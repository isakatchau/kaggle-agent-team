# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible endpoint works. Groq has a free tier:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
# For OpenAI itself, remove OPENAI_BASE_URL and use e.g. OPENAI_MODEL=gpt-4o-mini.
# OPENAI_MODEL overrides llm.model from the YAML config.
# Optional: a separate model (and rate-limit quota) for reading public notebooks:
OPENAI_MODEL_RESEARCH=qwen/qwen3.8-27b

# Kaggle: `kaggle auth login`, ~/.kaggle/access_token, or this variable.
# KAGGLE_API_TOKEN=
