{
  "reasoning": "LLM plan v1 + group target encoding: ticket, smoothing 1",
  "drop_columns": [
    "Name",
    "Ticket",
    "Cabin"
  ],
  "log_transform_columns": [
    "Fare"
  ],
  "datetime_columns": [],
  "frequency_encode_columns": [
    "Ticket",
    "Cabin",
    "Embarked"
  ],
  "text_length_columns": [
    "Name",
    "Ticket"
  ],
  "regex_features": [
    {
      "column": "Name",
      "pattern": ",\\s*([^\\.]+)\\.",
      "name": "Title"
    },
    {
      "column": "Cabin",
      "pattern": "^([A-Za-z])",
      "name": "Deck"
    },
    {
      "column": "Ticket",
      "pattern": "^([A-Za-z\\.\\/]+)",
      "name": "TicketPrefix"
    }
  ],
  "ratio_features": [],
  "group_size_columns": [
    [
      "SibSp",
      "Parch"
    ]
  ],
  "add_missing_indicators": true,
  "log_target": false,
  "group_target_encoding": [
    {
      "keys": [
        "Ticket"
      ],
      "name": "gte_ticket",
      "smoothing": 1.0
    }
  ]
}